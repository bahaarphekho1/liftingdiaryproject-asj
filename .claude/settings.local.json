{
  "permissions": {
    "allow": [
      "Bash(command -v clerk)",
      "Bash(clerk --version)",
      "Bash(npm install *)",
      "Bash(clerk auth *)",
      "Bash(clerk init *)",
      "Bash(clerk doctor *)",
      "Bash(npm run *)",
      "Read(//tmp/**)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx tsc *)",
      "Bash(TMPDIR=/tmp npx tsc --noEmit --skipLibCheck)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "neon"
  ]
}
